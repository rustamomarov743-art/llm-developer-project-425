# Скопируйте в .env и заполните: скрипты infra/deploy-*.sh берут значения оттуда
# и передают функциям. Значений по умолчанию в скриптах нет.
# [secret] — приходит из Lockbox, в .env не хранится.

# --- Деплой: infra/deploy-*.sh
YC=                    # путь к yc
SA_NAME=               # сервисный аккаунт функций, шлюза и workflow
DB_NAME=               # serverless-база YDB
GATEWAY_NAME=          # MCP-шлюз
WORKFLOW_NAME=
WORKFLOW_CRON=         # расписание дайджеста; значение с пробелами — в кавычках

# --- YDB: email-poller, ydb-tickets
YDB_ENDPOINT=          # [secret] ydb-endpoint
YDB_DATABASE=          # [secret] ydb-database

# --- Почта: email-poller, email-sender
HELPDESK_MAILBOX=      # адрес ящика поддержки, он же логин IMAP
IMAP_HOST=             # только email-poller
IMAP_PORT=             # только email-poller
IMAP_USER=             # только email-poller
IMAP_PASSWORD=         # [secret] email-credentials, только email-poller
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=         # [secret] email-credentials

# --- AI Studio: email-poller
YC_FOLDER_ID=
YC_AGENT_ID=
YC_VECTOR_STORE_ID=
YC_YDB_TICKETS_MCP_SERVER_URL=  # если пусто, скрипт берёт домен шлюза GATEWAY_NAME
YC_GUARD_MODEL=        # необязательная, по умолчанию yandexgpt-lite
EMAIL_BATCH=           # необязательная, писем за проход, по умолчанию 5

# --- Дайджест: email-sender
OPERATOR_EMAIL=
